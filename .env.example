# ==============================================================================
# Docker Compose Environment Template
# Copy this file to '.env' before running `docker compose up`.
# ==============================================================================

# Application Environment
NODE_ENV=production

# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=b2bmarketplace

# Backend Database Connection (Within Docker Network)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password
DB_DATABASE=b2bmarketplace

# Database Schema Auto-synchronization:
# Set to 'true' on the very FIRST boot to initialize tables, then switch to 'false'.
DB_SYNCHRONIZE=false

# Security & Authentication (JWT)
# Use a strong, random 256-bit string (e.g. generate via: `openssl rand -base64 32`)
JWT_SECRET=replace_with_a_secure_long_random_secret_key
