# ==============================================================================
# Backend Environment Configuration Template
# IMPORTANT: Copy this file to '.env' and fill in your actual environment secrets.
# NEVER commit the active '.env' file containing real secrets to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password
DB_DATABASE=b2bmarketplace

# Security & Authentication (JWT)
# Use a strong, random 256-bit string (e.g. generate via: `openssl rand -base64 32`)
JWT_SECRET=replace_with_a_secure_long_random_secret_key
JWT_EXPIRATION=7d

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=*
